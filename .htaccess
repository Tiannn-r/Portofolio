<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan arahkan jika membuka script deploy/importer langsung
    RewriteCond %{REQUEST_URI} ^/(artisan_deploy|extract_deploy|import_sql|clear_cache)\.php [NC]
    RewriteRule ^ - [L]

    # Arahkan semua request lainnya ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
